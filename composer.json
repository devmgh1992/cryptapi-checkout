{
    "name": "devmgh1992/cryptapi-checkout",
    "description": "Self-hosted crypto checkout for Laravel powered by CryptAPI: multi-coin picker, live deposit addresses, on-chain TXID verification and a time-boxed payment window.",
    "keywords": ["laravel", "crypto", "cryptapi", "payments", "checkout", "usdt", "tron", "bitcoin"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "bacon/bacon-qr-code": "^2.0|^3.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "suggest": {
        "ext-gmp": "Required to verify TRX and TRC-20 transactions (hex to base58 conversion)"
    },
    "autoload": {
        "psr-4": {
            "Nous\\CryptApiCheckout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nous\\CryptApiCheckout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nous\\CryptApiCheckout\\CryptApiCheckoutServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
